#!/usr/bin/env ruby
# frozen_string_literal: true

# nightshift command line. Usage: ns <command> <state-dir> [options]   (ns help, ns help <command>)

# Activate thor, the one runtime gem, without bundler/setup: Bundler would export
# BUNDLE_GEMFILE and RUBYOPT to every gate command, and break `bundle exec` in a Ruby
# project that nightshift works on.
begin
  gem "thor", "~> 1.5"
rescue Gem::LoadError
  abort "ns: the thor gem is missing. Install it with: gem install thor -v \"~> 1.5\""
end
require_relative "../lib/nightshift"

Nightshift::CLI.start(ARGV)
